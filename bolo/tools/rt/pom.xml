<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>
<!-- UI snapshot/smoke tests that run without an Android SDK (Robolectric + native graphics).
     The androidx.test stubs in src/test replace artifacts that live on Google's Maven. -->
<groupId>t</groupId><artifactId>t</artifactId><version>1</version>
<properties><maven.compiler.source>17</maven.compiler.source><maven.compiler.target>17</maven.compiler.target><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
<dependencies>
<dependency><groupId>org.robolectric</groupId><artifactId>robolectric</artifactId><version>4.14.1</version><scope>test</scope><exclusions><exclusion><groupId>androidx.test</groupId><artifactId>monitor</artifactId></exclusion><exclusion><groupId>androidx.test.espresso</groupId><artifactId>espresso-idling-resource</artifactId></exclusion><exclusion><groupId>androidx.test.ext</groupId><artifactId>junit</artifactId></exclusion></exclusions></dependency>
<dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
<dependency><groupId>org.robolectric</groupId><artifactId>android-all</artifactId><version>14-robolectric-10818077</version><scope>system</scope><systemPath>/tmp/claude-0/apk/dl/android-all.jar</systemPath></dependency>
</dependencies>
<build><sourceDirectory>../../src</sourceDirectory>
<plugins><plugin><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin></plugins></build></project>
