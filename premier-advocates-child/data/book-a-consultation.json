        "widgetType": "accordion",
        "settings": {
         "tabs": [
          {
           "_id": "c18ca31",
           "tab_title": "How do consultations take place?",
           "tab_content": "<p>All consultations take place by phone or video call, so you can speak to us confidentially from wherever you are. Once your booking is confirmed you’ll receive the details you need to join at your chosen time.</p>"
          },
          {
           "_id": "338d269",
           "tab_title": "What can I discuss in the consultation?",
           "tab_content": "<p>You can discuss any workplace issue you are facing – from disputes, grievances and investigations to disciplinary matters, settlement discussions and exit negotiations. We’ll listen, clarify the key issues and explain your options.</p>"
          },
          {
           "_id": "673747c",
           "tab_title": "Do you provide ongoing support after the consultation?",
           "tab_content": "<p>Yes. If you need further help after your consultation, we can discuss the options for ongoing support, including document review, negotiation support and continued strategic advice.</p>"
          },
          {
           "_id": "84e383d",
           "tab_title": "Can I change or cancel my booking?",
           "tab_content": "<p>Yes. If you need to change or cancel your booking, please contact us as soon as possible by email and we’ll do our best to arrange an alternative time.</p>"
          }
         ],
         "selected_icon": {
