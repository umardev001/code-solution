        "id": "c72d4f4",
        "elType": "widget",
        "widgetType": "text-editor",
        "settings": {
         "editor": "<p class=\"intro\">Send us a message and we’ll get back to you as soon as possible.</p>",
         "_css_classes": "intro"
        },
        "elements": []
       },
       {
        "id": "68c2d82",
        "elType": "widget",
        "widgetType": "html",
        "settings": {
         "html": "<form action=\"{{ajax_url}}\" class=\"form-card\" id=\"contact-form\" method=\"post\"=\"\">\n<input type=\"hidden\" name=\"action\" value=\"pa_contact\"><input type=\"hidden\" name=\"pa_ts\" value=\"\"><div class=\"pa-hp\" aria-hidden=\"true\"><label>Leave this field empty<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label></div><div class=\"field\">\n<label for=\"name\">Full Name <span class=\"req\">*</span></label>\n<input autocomplete=\"name\" id=\"name\" name=\"name\" placeholder=\"Your full name\" required=\"\" type=\"text\"/>\n</div>\n<div class=\"field\">\n<label for=\"email\">Email Address <span class=\"req\">*</span></label>\n<input autocomplete=\"email\" id=\"email\" name=\"email\" placeholder=\"your@emailaddress.co.uk\" required=\"\" type=\"email\"/>\n</div>\n<div class=\"field\">\n<label for=\"topic\">How can we help? <span class=\"req\">*</span></label>\n<select id=\"topic\" name=\"topic\" required=\"\">\n<option disabled=\"\" selected=\"\" value=\"\">Please select an option</option>\n<option>General enquiry</option>\n<option>Problems at work</option>\n<option>Senior executive support</option>\n<option>Booking a consultation</option>\n<option>Other</option>\n</select>\n</div>\n<div class=\"field\">\n<label for=\"message\">Your Message <span class=\"req\">*</span></label>\n<textarea id=\"message\" name=\"message\" placeholder=\"Tell us a little more about your situation...\" required=\"\"></textarea>\n</div>\n<label class=\"consent\">\n<input name=\"consent\" required=\"\" type=\"checkbox\"/>\n<span>I understand that the information I provide will be treated in confidence and used only to respond to my enquiry. <span class=\"req\">*</span></span>\n</label>\n<span class=\"btn btn-gold btn-block\"><button class=\"elementor-button\" type=\"submit\">Send Message</button></span>\n<p aria-live=\"polite\" class=\"form-status\" role=\"status\"></p>\n</form>",
         "_css_classes": "pa-form-widget"
        },
        "elements": []
       }
      ],
      "isInner": true
